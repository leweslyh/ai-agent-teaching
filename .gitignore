# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo

# 日志文件
*.log

# 本地服务运行时标记（由 _server.ps1 / _start_bg.ps1 生成）
_runtime.json

# 打包产物
*.zip

# 本机版本备份（按日期快照 + 打包好的 zip：体积大，只是本机留档，不进版本库）
/.00版本备份/

# 本机专用工具与预览产物（截图脚本 / 校验页 / 成图）
/tools/
/_preview/

# 启动 / 辅助脚本（本地静态服务、一键启动、截图，均属本机环境）
*.ps1
*.bat

# CodeBuddy 会话数据（计划、团队协作记录等，只属于本机工作环境）
/.codebuddy/
